# Copy this file to .env for local development.
# On Azure App Service, set these as Application Settings instead (not a .env file) -
# WEBSITE_HOSTNAME is set automatically by App Service, and is what tells the app
# it's running in "prod" mode (see config/environment.py).

PMONEXUS_SECRET_KEY="dev-only-secret-change-me"
DJANGO_DEBUG=true

# Optional - only needed once you're running more than one gunicorn worker in
# production (see config/settings.py CACHES). Leave blank locally; falls back
# to an in-process cache automatically.
REDIS_URL=""

# Leave blank locally to use sqlite (zero setup). Set to your Azure Postgres
# connection string in prod app settings, e.g.:
# postgresql://pmadmin:CHANGE_ME@YOURSERVER.postgres.database.azure.com:5432/pmonexus?sslmode=require
DATABASE_URL=""

# Azure Blob Storage - account URL only, no keys/connection strings.
# Auth is via ManagedIdentityCredential (prod) / DefaultAzureCredential (local, uses `az login`).
AZURE_STORAGE_ACCOUNT_URL="https://YOURSTORAGEACCOUNT.blob.core.windows.net"
AZURE_STORAGE_CONTAINER="task-attachments"

# --- Notifications ---
# Email (e.g. Office 365 SMTP). Leave EMAIL_HOST blank locally to print emails to console.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS="true"
DEFAULT_FROM_EMAIL="pmo@yourcompany.com"
# Microsoft Teams Incoming Webhook URL for the channel that should get updates.
TEAMS_WEBHOOK_URL=""
# Base URL used in notification links.
APP_BASE_URL="https://your-app.azurewebsites.net"
# Schedule daily: python manage.py send_due_reminders --days 3
